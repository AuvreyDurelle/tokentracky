{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build --workspace=@tokentracky/web",
  "outputDirectory": "apps/web/dist",
  "regions": ["lhr1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/gateway" },
    { "source": "/badge/(.*)", "destination": "/api/gateway" },
    { "source": "/card/(.*)", "destination": "/api/gateway" },
    { "source": "/(privacy|terms|support|leaderboard|you|join)", "destination": "/index.html" },
    { "source": "/u/:alias([a-zA-Z0-9][a-zA-Z0-9_-]{2,29})", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://kgchimxbzmuaezbvzmva.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
