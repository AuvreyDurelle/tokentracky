{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokentracky",
  "version": "0.2.0",
  "identifier": "com.tokentracky.desktop",
  "build": {},
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "../web/dist/": "web/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
