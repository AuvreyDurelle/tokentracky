# Values are injected by your deployment's secret manager. No .env auto-loading.
TOKENTRACKY_MODE=hosted
PORT=3000
# Hosted only: comma-separated trusted proxy peer IPs/CIDRs; empty disables forwarded-IP trust.
TOKENTRACKY_TRUSTED_PROXIES=
# Hosted only, opt-in Vercel gateway enforcement. Set both only after the Vercel gateway is deployed.
# TOKENTRACKY_REQUIRE_GATEWAY=true
# TOKENTRACKY_GATEWAY_SECRET=
DATABASE_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=
SUPABASE_URL=
# Public publishable/anon key only. Never a service_role or sb_secret key.
SUPABASE_PUBLISHABLE_KEY=
# Hosted only: sign-in methods enabled in Supabase Auth, comma-separated from email,github,google (default email).
TOKENTRACKY_AUTH_PROVIDERS=email
# Hosted/operator only: required private JSON with all ModerationPolicy fields (see packages/cloud/README.md).
TOKENTRACKY_MODERATION_POLICY=
# Local/desktop only: HTTPS origin of your deployed hosted service.
TOKENTRACKY_CLOUD_URL=
# Local/desktop only: refresh cycle interval in milliseconds (default 300000, minimum 60000).
TOKENTRACKY_REFRESH_INTERVAL_MS=
# Local/desktop only: set to off to keep the bundled LiteLLM price snapshot and skip the daily download.
TOKENTRACKY_PRICING_REFRESH=
